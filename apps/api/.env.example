DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/jobforge

# Email delivery (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Where "View in JobForge" links in emails point
APP_BASE_URL=http://localhost:3000

# Notifications
DIGEST_ENABLED=true
# Daily digest time, in each user's own timezone
DIGEST_HOUR=8
DIGEST_MINUTE=0
NOTIFICATION_MAX_ATTEMPTS=3
# Matches scoring below this are shown in the app but not notified
NOTIFICATION_MIN_SCORE=60

# Job sources to monitor, comma separated. Available:
#   mock, adzuna, remotive, remoteok, arbeitnow, jobicy, himalayas,
#   weworkremotely, greenhouse, lever, ashby
JOB_SOURCES=remotive,remoteok,arbeitnow,jobicy,himalayas,weworkremotely

# Adzuna (needs a free key from https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# Company career pages, comma-separated board names as they appear
# in each company's careers URL
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
ASHBY_BOARDS=
